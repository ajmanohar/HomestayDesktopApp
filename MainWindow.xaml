<Window x:Class="HomestayDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Homestay Form-C Desktop Assistant (Kochi)" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F1F5F9">

    <!-- Primary Grid: Split horizontally into Left Workspace and Right Portal View -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Pane: Document Ingestion, Diagnostics, and Editable Fields -->
            <ColumnDefinition Width="1.1*" MinWidth="520"/>
            <!-- Draggable Splitter -->
            <ColumnDefinition Width="6"/>
            <!-- Right Pane: Embedded Chromium WebView2 Official Portal -->
            <ColumnDefinition Width="1.2*" MinWidth="580"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================= -->
        <!-- LEFT WORKSPACE: INGESTION, PREVIEW & VERIFICATION                 -->
        <!-- ================================================================= -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <!-- Header Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Document Selection & Extraction Actions -->
                    <RowDefinition Height="Auto"/>
                    <!-- Status & Diagnostics -->
                    <RowDefinition Height="Auto"/>
                    <!-- Scrollable Review Form Fields -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Header Bar -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Form-C Desktop Verification" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Ingest guest documents, verify against Dell edge server, and auto-populate." FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 2. Document Selection Toolbar -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. Select Document Artifacts" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,8"/>
                        
                        <!-- File Pickers -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Passport Bio *:" VerticalAlignment="Center" FontSize="12" Foreground="#475569"/>
                            <TextBox x:Name="TxtPassportPath" Grid.Column="1" Height="26" VerticalContentAlignment="Center" IsReadOnly="True" Margin="4,0,4,0"/>
                            <Button x:Name="BtnBrowsePassport" Grid.Column="2" Content="Browse..." Height="26" Click="BtnBrowsePassport_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Visa / OCI:" VerticalAlignment="Center" FontSize="12" Foreground="#475569"/>
                            <TextBox x:Name="TxtVisaPath" Grid.Column="1" Height="26" VerticalContentAlignment="Center" IsReadOnly="True" Margin="4,0,4,0"/>
                            <Button x:Name="BtnBrowseVisa" Grid.Column="2" Content="Browse..." Height="26" Click="BtnBrowseVisa_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Entry Stamp:" VerticalAlignment="Center" FontSize="12" Foreground="#475569"/>
                            <TextBox x:Name="TxtStampPath" Grid.Column="1" Height="26" VerticalContentAlignment="Center" IsReadOnly="True" Margin="4,0,4,0"/>
                            <Button x:Name="BtnBrowseStamp" Grid.Column="2" Content="Browse..." Height="26" Click="BtnBrowseStamp_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Welcome Form:" VerticalAlignment="Center" FontSize="12" Foreground="#475569"/>
                            <TextBox x:Name="TxtWelcomePath" Grid.Column="1" Height="26" VerticalContentAlignment="Center" IsReadOnly="True" Margin="4,0,4,0"/>
                            <Button x:Name="BtnBrowseWelcome" Grid.Column="2" Content="Browse..." Height="26" Click="BtnBrowseWelcome_Click"/>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button x:Name="BtnProcessDocuments" Content="🚀 Send for Server Extraction" Height="32" Padding="14,0" 
                                    Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                    Click="BtnProcessDocuments_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. Status & Diagnostics Strip -->
                <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Status: Idle (Ready to ingest)" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="#334155"/>
                        <ProgressBar x:Name="PbExtraction" Grid.Column="1" Width="140" Height="14" IsIndeterminate="False" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- 4. Scrollable Form Review & Edit -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="2. Verified Form-C Bio-Data (Rule 14)" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,10"/>

                        <!-- Personal & Identity -->
                        <TextBlock Text="Surname:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtSurname" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Given Names:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtGivenNames" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sex (M/F):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtSex" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date of Birth:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtDob" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Passport Number:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtPassportNumber" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nationality:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtNationality" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Visa & Entry Stamp -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Visa Number:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtVisaNumber" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Visa Type:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtVisaType" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Arrival Date (India):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtArrivalDate" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Arrival Port (India):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtArrivalPort" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Homestay Movement -->
                        <TextBlock Text="Arrived From:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtArrivedFrom" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Proceeding To:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtProceedingTo" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Purpose of Visit:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtPurposeOfVisit" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Contact Email:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtEmail" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Contact Phone:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtPhone" Height="28" Margin="0,2,0,16" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================================================================= -->
        <!-- DRAGGABLE SPLITTER                                                -->
        <!-- ================================================================= -->
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E2E8F0" ResizeDirection="Columns"/>

        <!-- ================================================================= -->
        <!-- RIGHT WORKSPACE: MICROSOFT WEBVIEW2 PORTAL AUTOMATION             -->
        <!-- ================================================================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <!-- Quick Automation Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- Browser Viewport -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Automation Control Bar -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Official BoI Form-C Portal" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock x:Name="TxtCurrentUrl" Text="https://indianfrro.gov.in/frro/FormC/login.jsp" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Portal Autofill Credentials -->
                        <Button x:Name="BtnAutofillLogin" Content="🔑 Autofill Login" Height="32" Padding="12,0" Margin="0,0,8,0"
                                Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                Click="BtnAutofillLogin_Click"/>

                        <!-- Portal Autofill Guest Fields -->
                        <Button x:Name="BtnAutofillFields" Content="📝 Inject Guest Fields" Height="32" Padding="12,0" Margin="0,0,8,0"
                                Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                Click="BtnAutofillFields_Click"/>

                        <!-- Reload View -->
                        <Button x:Name="BtnReloadWeb" Content="⟳" Height="32" Width="36" FontWeight="Bold"
                                Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0"
                                Click="BtnReloadWeb_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chromium WebView2 Workspace -->
            <wv2:WebView2 x:Name="PortalWebView" Grid.Row="1" Source="https://indianfrro.gov.in/frro/FormC/login.jsp"/>
        </Grid>
    </Grid>
</Window>