<Window Background="#0F172A" Height="920" Title="Homestay Form-C Desktop Assistant (Kochi)" Width="1440" WindowStartupLocation="CenterScreen" WindowState="Maximized" mc:Ignorable="d" x:Class="HomestayDesktopApp.MainWindow" xmlns="[http://schemas.microsoft.com/winfx/2006/xaml/presentation](http://schemas.microsoft.com/winfx/2006/xaml/presentation)" xmlns:d="[http://schemas.microsoft.com/expression/blend/2008](http://schemas.microsoft.com/expression/blend/2008)" xmlns:mc="[http://schemas.openxmlformats.org/markup-compatibility/2006](http://schemas.openxmlformats.org/markup-compatibility/2006)" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" xmlns:x="[http://schemas.microsoft.com/winfx/2006/xaml](http://schemas.microsoft.com/winfx/2006/xaml)">

    <Grid>
        <!-- ================================================================= -->
        <!-- VIEW 1: HOME DASHBOARD / LANDING SCREEN (ACTION TILES)            -->
        <!-- ================================================================= -->
        <Grid Background="#F8FAFC" Visibility="Visible" x:Name="ViewDashboard">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Dashboard Top Header Bar -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Grid.Row="0" Padding="32,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#0F172A" Text="Homestay Form-C Assistant"/>
                        <TextBlock FontSize="13" Foreground="#64748B" Margin="0,4,0,0" Text="Bureau of Immigration Registration &amp; Extraction Hub"/>
                    </StackPanel>
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="20" Grid.Column="1" Padding="14,6" VerticalAlignment="Center">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#059669" Text="● Dell Edge Server Connected"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Action Tiles Grid -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="30" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- TILE 1 (PRIMARY): REVIEW & RETRIEVE SUBMISSIONS -->
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Cursor="Hand" Grid.Column="0" MouseLeftButtonUp="TileRetrieveSubmissions_Click" Padding="28">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Color="#94A3B8" Direction="270" Opacity="0.15" ShadowDepth="4"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <Border Background="#EEF2FF" CornerRadius="28" Height="56" HorizontalAlignment="Left" Margin="0,0,0,16" Width="56">
                            <TextBlock FontSize="26" HorizontalAlignment="Center" Text="📂" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8" Text="Review &amp; Retrieve Submissions"/>
                        <TextBlock FontSize="12" Foreground="#64748B" LineHeight="18" Margin="0,0,0,24" Text="View tabular submissions sent from mobile. Inspect high-res documents, portrait photos, cycle through guests in that submission, and launch filing." TextWrapping="Wrap"/>
                        <Button Background="#4F46E5" BorderThickness="0" Click="TileRetrieveSubmissions_Click" Content="Open Submissions Table →" FontWeight="Bold" Foreground="#FFFFFF" Height="40"/>
                    </StackPanel>
                </Border>

                <!-- TILE 2: ENCRYPTED FORM-C PORTAL CREDENTIALS -->
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Cursor="Hand" Grid.Column="2" MouseLeftButtonUp="TileCredentials_Click" Padding="28">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Color="#94A3B8" Direction="270" Opacity="0.15" ShadowDepth="4"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <Border Background="#FEF3C7" CornerRadius="28" Height="56" HorizontalAlignment="Left" Margin="0,0,0,16" Width="56">
                            <TextBlock FontSize="26" HorizontalAlignment="Center" Text="🔐" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8" Text="Portal Credentials"/>
                        <TextBlock FontSize="12" Foreground="#64748B" LineHeight="18" Margin="0,0,0,24" Text="Store your Form-C user ID and password encrypted via Windows DPAPI. Enter once and forget; autofill uses them seamlessly without prompting." TextWrapping="Wrap"/>
                        <Button Background="#D97706" BorderThickness="0" Click="TileCredentials_Click" Content="Manage Saved Credentials ⚙" FontWeight="Bold" Foreground="#FFFFFF" Height="40"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- VIEW 2: SUBMISSIONS TABULAR DATAGRID SCREEN                       -->
        <!-- ================================================================= -->
        <Grid Background="#F8FAFC" Visibility="Collapsed" x:Name="ViewSubmissionsList">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Navigation Bar -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Grid.Row="0" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Background="#F1F5F9" BorderThickness="0" Click="BtnBackToDashboard_Click" Content="⬅ Back to Dashboard" FontWeight="SemiBold" Foreground="#334155" Grid.Column="0" Height="34" Padding="14,0"/>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#0F172A" Grid.Column="1" Margin="20,0,0,0" Text="Recent Homestay Submissions" VerticalAlignment="Center"/>
                    <Button Background="#EEF2FF" BorderThickness="0" Click="BtnRefreshSubmissions_Click" Content="⟳ Refresh Submissions" FontWeight="SemiBold" Foreground="#4F46E5" Grid.Column="2" Height="34" Padding="14,0"/>
                </Grid>
            </Border>

            <!-- Tabular Submissions Table -->
            <Grid Grid.Row="1" Margin="28">
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12">
                    <DataGrid AutoGenerateColumns="False" Background="Transparent" BorderThickness="0" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="#F1F5F9" IsReadOnly="True" MouseDoubleClick="DgSubmissions_MouseDoubleClick" RowHeight="44" x:Name="DgSubmissions">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding CreatedAt}" Header="Captured Date" Width="180"/>
                            <DataGridTextColumn Binding="{Binding DisplayTitle}" Header="Lead Guest / Reference" Width="*"/>
                            <DataGridTextColumn Binding="{Binding GuestCount}" Header="No. of Guests" Width="120"/>
                            <DataGridTemplateColumn Header="Status" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9" CornerRadius="12" HorizontalAlignment="Left" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#334155" Text="{Binding Status}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Action" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Background="#4F46E5" BorderThickness="0" Click="BtnSelectSubmission_Click" Content="Review Guests →" FontWeight="Bold" Foreground="#FFFFFF" Height="28" Padding="12,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- VIEW 3: MULTI-GUEST SPLIT-SCREEN REVIEW (ISOLATED TO SUBMISSION)  -->
        <!-- ================================================================= -->
        <Grid Background="#FFFFFF" Visibility="Collapsed" x:Name="ViewGuestReview">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Guest Carousel Control -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Grid.Row="0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Background="#F1F5F9" BorderThickness="0" Click="BtnBackToSubmissions_Click" Content="⬅ Back to Submissions" FontWeight="SemiBold" Foreground="#334155" Grid.Column="0" Height="34" Padding="12,0"/>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Background="#F1F5F9" BorderThickness="0" Click="BtnPrevGuest_Click" Content="◀ Prev Guest" FontWeight="SemiBold" Foreground="#334155" Height="32" Padding="12,0" x:Name="BtnPrevGuest"/>
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="16,0" Text="Guest 1 of 1: Lead Guest" VerticalAlignment="Center" x:Name="TxtGuestCounter"/>
                        <Button Background="#F1F5F9" BorderThickness="0" Click="BtnNextGuest_Click" Content="Next Guest ▶" FontWeight="SemiBold" Foreground="#334155" Height="32" Padding="12,0" x:Name="BtnNextGuest"/>
                    </StackPanel>

                    <Button Background="#059669" BorderThickness="0" Click="BtnLaunchPortal_Click" Content="🚀 Launch Form-C Portal Runner →" FontWeight="Bold" Foreground="#FFFFFF" Grid.Column="2" Height="36" Padding="20,0"/>
                </Grid>
            </Border>

            <!-- Split View: Document Scans & Portrait on Left, Form Fields on Right -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="480" Width="1.1*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition MinWidth="440" Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Document Image & Portrait Inspection -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Grid.Column="0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Document & Photo Type Selector Tabs -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
                            <RadioButton Checked="DocTab_Checked" Content="Passport Bio" IsChecked="True" Margin="0,0,4,0" Padding="10,6" Style="{StaticResource {x:Type ToggleButton}}" x:Name="TabPassport"/>
                            <RadioButton Checked="DocTab_Checked" Content="e-Visa Doc" Margin="0,0,4,0" Padding="10,6" Style="{StaticResource {x:Type ToggleButton}}" x:Name="TabVisaDoc"/>
                            <RadioButton Checked="DocTab_Checked" Content="Visa Stamp" Margin="0,0,4,0" Padding="10,6" Style="{StaticResource {x:Type ToggleButton}}" x:Name="TabVisa"/>
                            <RadioButton Checked="DocTab_Checked" Content="Entry Stamp" Margin="0,0,4,0" Padding="10,6" Style="{StaticResource {x:Type ToggleButton}}" x:Name="TabStamp"/>
                            <RadioButton Checked="DocTab_Checked" Content="Form-C Slip" Margin="0,0,4,0" Padding="10,6" Style="{StaticResource {x:Type ToggleButton}}" x:Name="TabWelcome"/>
                            <RadioButton Checked="DocTab_Checked" Content="Guest Photo" Margin="0,0,4,0" Padding="10,6" Style="{StaticResource {x:Type ToggleButton}}" x:Name="TabPhoto"/>
                        </StackPanel>

                        <!-- Interactive Zoom Bar -->
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Grid.Row="1" Margin="0,0,0,8" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="11" Foreground="#64748B" Grid.Column="0" Text="Zoom: Fit to Frame (100%)" VerticalAlignment="Center" x:Name="TxtZoomLevel"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Background="#F1F5F9" BorderThickness="0" Click="BtnZoomOut_Click" Content="− Zoom Out" FontSize="11" Foreground="#334155" Height="24" Margin="0,0,4,0" Padding="8,0"/>
                                    <Button Background="#EEF2FF" BorderThickness="0" Click="BtnZoomReset_Click" Content="Fit Entire Image" FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5" Height="24" Margin="0,0,4,0" Padding="8,0"/>
                                    <Button Background="#F1F5F9" BorderThickness="0" Click="BtnZoomIn_Click" Content="+ Zoom In" FontSize="11" Foreground="#334155" Height="24" Padding="8,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Scrollable / Zoomable Document Viewer -->
                        <Border Background="#0F172A" ClipToBounds="True" CornerRadius="6" Grid.Row="2" x:Name="ViewerContainer">
                            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="ImgScrollViewer_PreviewMouseWheel" VerticalScrollBarVisibility="Auto" x:Name="ImgScrollViewer">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image MaxHeight="{Binding ActualHeight, ElementName=ViewerContainer}" MaxWidth="{Binding ActualWidth, ElementName=ViewerContainer}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" x:Name="ImgDocumentPreview">
                                        <Image.LayoutTransform>
                                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" x:Name="ImageScaleTransform"/>
                                        </Image.LayoutTransform>
                                    </Image>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Background="#E2E8F0" Grid.Column="1" HorizontalAlignment="Stretch"/>

                <!-- Right Column: Form-C Field Editor with Explicit Date Format Labels -->
                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" Padding="20" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#0F172A" Grid.Column="0" Text="Form-C Verified Details (Rule 14)" VerticalAlignment="Center"/>
                            <Button Background="#EEF2FF" BorderThickness="0" Click="BtnSaveEdits_Click" Content="💾 Save Overrides" FontWeight="Bold" Foreground="#4F46E5" Grid.Column="1" Height="28" Padding="12,0"/>
                        </Grid>

                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Surname (Family Name):"/>
                        <TextBox Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center" x:Name="TxtReviewSurname"/>

                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Given Names:"/>
                        <TextBox Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center" x:Name="TxtReviewGivenNames"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Sex (M / F / X):"/>
                                <TextBox Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center" x:Name="TxtReviewSex"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Date of Birth (DD-MM-YYYY):"/>
                                <TextBox Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center" x:Name="TxtReviewDob"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Passport Number:"/>
                                <TextBox Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center" x:Name="TxtReviewPassportNumber"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Passport Expiry Date (DD-MM-YYYY):"/>
                                <TextBox Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center" x:Name="TxtReviewPassportExpiry"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Nationality:"/>
                        <TextBox Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center" x:Name="TxtReviewNationality"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Visa Number:"/>
                                <TextBox Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center" x:Name="TxtReviewVisaNumber"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Visa Type:"/>
                                <TextBox Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center" x:Name="TxtReviewVisaType"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Visa Issue Date (DD-MM-YYYY):"/>
                                <TextBox Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center" x:Name="TxtReviewVisaIssueDate"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Visa Expiry Date (DD-MM-YYYY):"/>
                                <TextBox Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center" x:Name="TxtReviewVisaExpiryDate"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Visa Place of Issue / Mission:"/>
                        <TextBox Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center" x:Name="TxtReviewVisaPlaceOfIssue"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Arrival Date in India (DD-MM-YYYY):"/>
                                <TextBox Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center" x:Name="TxtReviewArrivalDate"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Arrival Port (India):"/>
                                <TextBox Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center" x:Name="TxtReviewArrivalPort"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Arrived From (Previous City / Port):"/>
                        <TextBox Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center" x:Name="TxtReviewArrivedFrom"/>

                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Proceeding To (Next Destination):"/>
                        <TextBox Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center" x:Name="TxtReviewProceedingTo"/>

                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Purpose of Visit &amp; Profession:"/>
                        <TextBox Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center" x:Name="TxtReviewPurposeOfVisit"/>

                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Row 2: Permanent Residential Address:"/>
                        <TextBox Height="48" Margin="0,2,0,8" TextWrapping="Wrap" VerticalContentAlignment="Top" x:Name="TxtReviewAddress"/>

                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Contact Email:"/>
                        <TextBox Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center" x:Name="TxtReviewEmail"/>

                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#475569" Text="Contact Phone:"/>
                        <TextBox Height="28" Margin="0,2,0,16" VerticalContentAlignment="Center" x:Name="TxtReviewPhone"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- VIEW 4: OFFICIAL FORM-C PORTAL RUNNER WORKSPACE                  -->
        <!-- ================================================================= -->
        <Grid Background="#FFFFFF" Visibility="Collapsed" x:Name="ViewPortalRunner">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Portal Automation Top Bar -->
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Grid.Row="0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Background="#F1F5F9" BorderThickness="0" Click="BtnBackToGuestReview_Click" Content="⬅ Back to Guest Review" FontWeight="SemiBold" Foreground="#334155" Grid.Column="0" Height="34" Padding="12,0"/>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,14,0" Text="Active Guest: Lead Guest (1 of 1)" VerticalAlignment="Center" x:Name="TxtPortalActiveGuest"/>
                        <Button Background="#EEF2FF" BorderThickness="0" Click="BtnPortalNextGuest_Click" Content="Switch to Next Guest ➡" FontWeight="Bold" Foreground="#4F46E5" Height="30" Padding="10,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Background="#059669" BorderThickness="0" Click="BtnAutofillLogin_Click" Content="🔑 Autofill Login" FontWeight="Bold" Foreground="#FFFFFF" Height="34" Margin="0,0,8,0" Padding="14,0"/>
                        <Button Background="#7C3AED" BorderThickness="0" Click="BtnAutofillFields_Click" Content="📝 Inject Active Guest Fields" FontWeight="Bold" Foreground="#FFFFFF" Height="34" Margin="0,0,8,0" Padding="14,0"/>
                        <Button Background="#E2E8F0" BorderThickness="0" Click="BtnReloadWeb_Click" Content="⟳" FontWeight="Bold" Foreground="#1E293B" Height="34" Width="38"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Microsoft WebView2 Workspace -->
            <wv2:WebView2 x:Name="PortalWebView" Grid.Row="1" Source="[https://indianfrro.gov.in/frro/FormC/login.jsp](https://indianfrro.gov.in/frro/FormC/login.jsp)"/>
        </Grid>

        <!-- ================================================================= -->
        <!-- MODAL OVERLAY: ENCRYPTED CREDENTIALS SETTINGS DIALOG              -->
        <!-- ================================================================= -->
        <Grid Background="#80000000" Visibility="Collapsed" x:Name="ModalCredentials">
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" Padding="28" VerticalAlignment="Center" Width="440">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Color="#000000" Direction="270" Opacity="0.3" ShadowDepth="8"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" Text="Form-C Portal Credentials"/>
                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,0,0,16" Text="Credentials will be securely encrypted using Windows DPAPI and stored in your Windows user profile." TextWrapping="Wrap"/>

                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" Text="User ID / Username:"/>
                    <TextBox Height="32" Margin="0,0,0,12" VerticalContentAlignment="Center" x:Name="TxtModalUserId"/>

                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" Text="Password:"/>
                    <PasswordBox Height="32" Margin="0,0,0,20" VerticalContentAlignment="Center" x:Name="TxtModalPassword"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Background="#F1F5F9" BorderThickness="0" Click="BtnCloseCredsModal_Click" Content="Cancel" FontWeight="SemiBold" Foreground="#475569" Grid.Column="0" Height="36"/>
