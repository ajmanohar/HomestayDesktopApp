<Window x:Class="HomestayDesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Homestay Form-C Desktop Assistant (Kochi)" Height="920" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0F172A">

    <Grid>
        <!-- ================================================================= -->
        <!-- VIEW 1: HOME DASHBOARD / LANDING SCREEN (ACTION TILES)            -->
        <!-- ================================================================= -->
        <Grid x:Name="ViewDashboard" Visibility="Visible" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Dashboard Top Header Bar -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="32,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Homestay Form-C Assistant" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Bureau of Immigration Registration &amp; Extraction Hub" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                        <TextBlock Text="● Dell Edge Server Connected" FontSize="12" FontWeight="SemiBold" Foreground="#059669"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Action Tiles Grid -->
            <Grid Grid.Row="1" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- TILE 1 (PRIMARY): REVIEW & RETRIEVE SUBMISSIONS -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="28"
                        Cursor="Hand" MouseLeftButtonUp="TileRetrieveSubmissions_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#94A3B8" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <Border Background="#EEF2FF" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="📂" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Review &amp; Retrieve Submissions" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <TextBlock Text="View tabular submissions sent from mobile. Inspect high-res documents, portrait photos, cycle through guests in that submission, and launch filing."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,24"/>
                        <Button Content="Open Submissions Table →" Height="40" Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold"
                                BorderThickness="0" Click="TileRetrieveSubmissions_Click"/>
                    </StackPanel>
                </Border>

                <!-- TILE 2: ENCRYPTED FORM-C PORTAL CREDENTIALS -->
                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="28"
                        Cursor="Hand" MouseLeftButtonUp="TileCredentials_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#94A3B8" Opacity="0.15"/>
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Center">
                        <Border Background="#FEF3C7" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="🔐" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Portal Credentials" FontSize="18" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                        <TextBlock Text="Store your Form-C user ID and password encrypted via Windows DPAPI. Enter once and forget; autofill uses them seamlessly without prompting."
                                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,24"/>
                        <Button Content="Manage Saved Credentials ⚙" Height="40" Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold"
                                BorderThickness="0" Click="TileCredentials_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- VIEW 2: SUBMISSIONS TABULAR DATAGRID SCREEN                       -->
        <!-- ================================================================= -->
        <Grid x:Name="ViewSubmissionsList" Visibility="Collapsed" Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Navigation Bar -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="⬅ Back to Dashboard" Height="34" Padding="14,0" FontWeight="SemiBold"
                            Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Click="BtnBackToDashboard_Click"/>
                    <TextBlock Grid.Column="1" Text="Recent Homestay Submissions" FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <Button Grid.Column="2" Content="⟳ Refresh Submissions" Height="34" Padding="14,0" FontWeight="SemiBold"
                            Background="#EEF2FF" Foreground="#4F46E5" BorderThickness="0" Click="BtnRefreshSubmissions_Click"/>
                </Grid>
            </Border>

            <!-- Tabular Submissions Table -->
            <Grid Grid.Row="1" Margin="28">
                <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12">
                    <DataGrid x:Name="DgSubmissions" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9" RowHeight="44" BorderThickness="0" Background="Transparent"
                              MouseDoubleClick="DgSubmissions_MouseDoubleClick">
                        <DataGrid.Columns>
                            <!-- Date Column -->
                            <DataGridTextColumn Header="Captured Date" Binding="{Binding CreatedAt}" Width="180"/>
                            <!-- Reference / Guest Name Column -->
                            <DataGridTextColumn Header="Lead Guest / Reference" Binding="{Binding DisplayTitle}" Width="*"/>
                            <!-- Guest Count Column -->
                            <DataGridTextColumn Header="No. of Guests" Binding="{Binding GuestCount}" Width="120"/>
                            <!-- Status Column -->
                            <DataGridTemplateColumn Header="Status" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11" Foreground="#334155"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Action Column -->
                            <DataGridTemplateColumn Header="Action" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Review Guests →" Height="28" Padding="12,0" Background="#4F46E5" Foreground="#FFFFFF"
                                                FontWeight="Bold" BorderThickness="0" Click="BtnSelectSubmission_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- VIEW 3: MULTI-GUEST SPLIT-SCREEN REVIEW (ISOLATED TO SUBMISSION)  -->
        <!-- ================================================================= -->
        <Grid x:Name="ViewGuestReview" Visibility="Collapsed" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header & Guest Carousel Control -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="⬅ Back to Submissions" Height="34" Padding="12,0" FontWeight="SemiBold"
                            Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Click="BtnBackToSubmissions_Click"/>

                    <!-- Guest Carousel Navigation -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnPrevGuest" Content="◀ Prev Guest" Height="32" Padding="12,0" Background="#F1F5F9" Foreground="#334155"
                                FontWeight="SemiBold" BorderThickness="0" Click="BtnPrevGuest_Click"/>
                        <TextBlock x:Name="TxtGuestCounter" Text="Guest 1 of 1: Lead Guest" FontSize="14" FontWeight="Bold" Foreground="#0F172A"
                                   VerticalAlignment="Center" Margin="16,0"/>
                        <Button x:Name="BtnNextGuest" Content="Next Guest ▶" Height="32" Padding="12,0" Background="#F1F5F9" Foreground="#334155"
                                FontWeight="SemiBold" BorderThickness="0" Click="BtnNextGuest_Click"/>
                    </StackPanel>

                    <!-- Proceed to Portal Button -->
                    <Button Grid.Column="2" Content="🚀 Launch Form-C Portal Runner →" Height="36" Padding="20,0"
                            Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                            Click="BtnLaunchPortal_Click"/>
                </Grid>
            </Border>

            <!-- Split View: Document Scans & Portrait on Left, Form Fields on Right -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" MinWidth="480"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="1*" MinWidth="440"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Document Image & Portrait Inspection -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Document & Photo Type Selector Tabs (Task 42: Dual Visa Support) -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton x:Name="TabPassport" Content="Passport Bio" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}"
                                         Padding="10,6" Margin="0,0,4,0" Checked="DocTab_Checked"/>
                            <RadioButton x:Name="TabVisaDoc" Content="e-Visa Doc" Style="{StaticResource {x:Type ToggleButton}}"
                                         Padding="10,6" Margin="0,0,4,0" Checked="DocTab_Checked"/>
                            <RadioButton x:Name="TabVisa" Content="Visa Stamp" Style="{StaticResource {x:Type ToggleButton}}"
                                         Padding="10,6" Margin="0,0,4,0" Checked="DocTab_Checked"/>
                            <RadioButton x:Name="TabStamp" Content="Entry Stamp" Style="{StaticResource {x:Type ToggleButton}}"
                                         Padding="10,6" Margin="0,0,4,0" Checked="DocTab_Checked"/>
                            <RadioButton x:Name="TabWelcome" Content="Form-C Slip" Style="{StaticResource {x:Type ToggleButton}}"
                                         Padding="10,6" Margin="0,0,4,0" Checked="DocTab_Checked"/>
                            <RadioButton x:Name="TabPhoto" Content="Guest Photo" Style="{StaticResource {x:Type ToggleButton}}"
                                         Padding="10,6" Margin="0,0,4,0" Checked="DocTab_Checked"/>
                        </StackPanel>

                        <!-- Interactive Zoom Bar -->
                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtZoomLevel" Grid.Column="0" Text="Zoom: Fit to Frame (100%)" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="− Zoom Out" Height="24" Padding="8,0" Margin="0,0,4,0" FontSize="11"
                                            Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Click="BtnZoomOut_Click"/>
                                    <Button Content="Fit Entire Image" Height="24" Padding="8,0" Margin="0,0,4,0" FontSize="11"
                                            Background="#EEF2FF" Foreground="#4F46E5" FontWeight="SemiBold" BorderThickness="0" Click="BtnZoomReset_Click"/>
                                    <Button Content="+ Zoom In" Height="24" Padding="8,0" FontSize="11"
                                            Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Click="BtnZoomIn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Scrollable / Zoomable Document Viewer -->
                        <Border x:Name="ViewerContainer" Grid.Row="2" Background="#0F172A" CornerRadius="6" ClipToBounds="True">
                            <ScrollViewer x:Name="ImgScrollViewer" 
                                          HorizontalScrollBarVisibility="Auto" 
                                          VerticalScrollBarVisibility="Auto"
                                          Focusable="False"
                                          PreviewMouseWheel="ImgScrollViewer_PreviewMouseWheel">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image x:Name="ImgDocumentPreview" 
                                           Stretch="Uniform"
                                           MaxWidth="{Binding ActualWidth, ElementName=ViewerContainer}"
                                           MaxHeight="{Binding ActualHeight, ElementName=ViewerContainer}"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.LayoutTransform>
                                            <ScaleTransform x:Name="ImageScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                        </Image.LayoutTransform>
                                    </Image>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E2E8F0"/>

                <!-- Right Column: Form-C Field Editor with Explicit Date Format Labels (Task 48) -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Form-C Verified Details (Rule 14)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="💾 Save Overrides" Height="28" Padding="12,0" Background="#EEF2FF" Foreground="#4F46E5"
                                    FontWeight="Bold" BorderThickness="0" Click="BtnSaveEdits_Click"/>
                        </Grid>

                        <TextBlock Text="Surname (Family Name):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtReviewSurname" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Given Names:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtReviewGivenNames" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sex (M / F / X):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtReviewSex" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Date of Birth (DD-MM-YYYY):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtReviewDob" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Passport Number:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtReviewPassportNumber" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Passport Expiry Date (DD-MM-YYYY):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtReviewPassportExpiry" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Nationality:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtReviewNationality" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Visa Number:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtReviewVisaNumber" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Visa Type:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtReviewVisaType" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Visa Issue Date (DD-MM-YYYY):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtReviewVisaIssueDate" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Visa Expiry Date (DD-MM-YYYY):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtReviewVisaExpiryDate" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Visa Place of Issue / Mission:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtReviewVisaPlaceOfIssue" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Arrival Date in India (DD-MM-YYYY):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtReviewArrivalDate" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Arrival Port (India):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                <TextBox x:Name="TxtReviewArrivalPort" Height="28" Margin="0,2,0,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Arrived From (Previous City / Port):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtReviewArrivedFrom" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Proceeding To (Next Destination):" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtReviewProceedingTo" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Purpose of Visit &amp; Profession:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtReviewPurposeOfVisit" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Row 2: Permanent Residential Address:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtReviewAddress" Height="48" TextWrapping="Wrap" Margin="0,2,0,8" VerticalContentAlignment="Top"/>

                        <TextBlock Text="Contact Email:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtReviewEmail" Height="28" Margin="0,2,0,8" VerticalContentAlignment="Center"/>

                        <TextBlock Text="Contact Phone:" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBox x:Name="TxtReviewPhone" Height="28" Margin="0,2,0,16" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================================================================= -->
        <!-- VIEW 4: OFFICIAL FORM-C PORTAL RUNNER WORKSPACE                  -->
        <!-- ================================================================= -->
        <Grid x:Name="ViewPortalRunner" Visibility="Collapsed" Background="#FFFFFF">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Portal Automation Top Bar -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="⬅ Back to Guest Review" Height="34" Padding="12,0" FontWeight="SemiBold"
                            Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Click="BtnBackToGuestReview_Click"/>

                    <!-- Guest Injection Indicator & Carousel Within Submission -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPortalActiveGuest" Text="Active Guest: Lead Guest (1 of 1)" FontSize="13" FontWeight="Bold"
                                   Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button Content="Switch to Next Guest ➡" Height="30" Padding="10,0" Background="#EEF2FF" Foreground="#4F46E5"
                                FontWeight="Bold" BorderThickness="0" Click="BtnPortalNextGuest_Click"/>
                    </StackPanel>

                    <!-- Quick Automation Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="🔑 Autofill Login" Height="34" Padding="14,0" Margin="0,0,8,0"
                                Background="#059669" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                Click="BtnAutofillLogin_Click"/>
                        <Button Content="📝 Inject Active Guest Fields" Height="34" Padding="14,0" Margin="0,0,8,0"
                                Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                                Click="BtnAutofillFields_Click"/>
                        <Button Content="⟳" Height="34" Width="38" Background="#E2E8F0" Foreground="#1E293B" FontWeight="Bold"
                                BorderThickness="0" Click="BtnReloadWeb_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Microsoft WebView2 Workspace -->
            <wv2:WebView2 x:Name="PortalWebView" Grid.Row="1" Source="https://indianfrro.gov.in/frro/FormC/login.jsp"/>
        </Grid>

        <!-- ================================================================= -->
        <!-- MODAL OVERLAY: ENCRYPTED CREDENTIALS SETTINGS DIALOG              -->
        <!-- ================================================================= -->
        <Grid x:Name="ModalCredentials" Visibility="Collapsed" Background="#80000000">
            <Border Background="#FFFFFF" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="12" Padding="28" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Form-C Portal Credentials" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                    <TextBlock Text="Credentials will be securely encrypted using Windows DPAPI and stored in your Windows user profile."
                               FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="User ID / Username:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtModalUserId" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Password:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="TxtModalPassword" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Height="36" Background="#F1F5F9" Foreground="#475569" FontWeight="SemiBold"
                                BorderThickness="0" Click="BtnCloseCredsModal_Click"/>
                        <Button Grid.Column="2" Content="Save Encrypted 🔐" Height="36" Background="#D97706" Foreground="#FFFFFF" FontWeight="Bold"
                                BorderThickness="0" Click="BtnSaveCredsModal_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>